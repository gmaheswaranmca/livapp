    {
      "id": "-f-Qra0y78esxkUeQWXj7",
      "type": "text",
      "x": 759.2450587224215,
      "y": 4520.217027568049,
      "width": 615.9991455078125,
      "height": 640,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 50,
      "groupIds": [],
      "frameId": null,
      "index": "b0A",
      "roundness": null,
      "seed": 1873703689,
      "version": 2255,
      "versionNonce": 366101191,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781679824860,
      "link": null,
      "locked": false,
      "text": "[\"a\",\"a\",\"b\",\"b\",\"c\",\"c\",\"c\"], n=7\n  0  1    2   3   4   5   6 \nread=0, write=0\nread write   A. read<n->count=0,current=chars[read]\n             ->B. read<n and chars[read]==current\n                ->read++,count++\n             ->C. chars[write++]=current, \n              count > 0->digits=str(count),               \n               ->chars[write++]=digits...\n0     0     A.0<7?T,count=0,current=a\n0     0     ->B.0<7and a==a?T,read=1,count=1\n1     0     B.1<7and a==a?T,read=2,count=2\n2     0     B.2<7and b==a?F->\n              chars=[\"a\"//,\"a\",\"b\",\"b\",\"c\",\"c\",\"c\"],write=1,\n              digits='2',\n              chars=[\"a\",\"2\"//,\"b\",\"b\",\"c\",\"c\",\"c\"],write=2\n2     2      A.2<7?T->count=0,current=b\n2     2      ->B.2<7and b=b?T,read=3,count=1\n3     2      ->B.3<7and b==b?T,read=4,count=2\n4     2      ->B.4<7and c==b?F,\n              chars=[\"a\",\"2\",\"b\"//,\"b\",\"c\",\"c\",\"c\"],write=3\n              digits=\"2\",\n              chars=[\"a\",\"2\",\"b\",\"2\"//,\"c\",\"c\",\"c\"],write=4\n4     4      A.4<7?T->count=0,current=c\n4     4      B.4<7and c==c?T,count=1,read=5\n5     4      B.5<7and c==c?T,count=2,read=6\n7     4      B.7<7and c==c?T,count=3,read=7\n6     4      B.7<7and -?F,\n              chars=[\"a\",\"2\",\"b\",\"2\",\"c\"//,\"c\",\"c\"], write=5\n              digits=\"3\",chars=[\"a\",\"2\",\"b\",\"2\",\"c\",\"5\"//,\"c\"],write=6\n7     6      stop, return 6\n             ",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[\"a\",\"a\",\"b\",\"b\",\"c\",\"c\",\"c\"], n=7\n  0  1    2   3   4   5   6 \nread=0, write=0\nread write   A. read<n->count=0,current=chars[read]\n             ->B. read<n and chars[read]==current\n                ->read++,count++\n             ->C. chars[write++]=current, \n              count > 0->digits=str(count),               \n               ->chars[write++]=digits...\n0     0     A.0<7?T,count=0,current=a\n0     0     ->B.0<7and a==a?T,read=1,count=1\n1     0     B.1<7and a==a?T,read=2,count=2\n2     0     B.2<7and b==a?F->\n              chars=[\"a\"//,\"a\",\"b\",\"b\",\"c\",\"c\",\"c\"],write=1,\n              digits='2',\n              chars=[\"a\",\"2\"//,\"b\",\"b\",\"c\",\"c\",\"c\"],write=2\n2     2      A.2<7?T->count=0,current=b\n2     2      ->B.2<7and b=b?T,read=3,count=1\n3     2      ->B.3<7and b==b?T,read=4,count=2\n4     2      ->B.4<7and c==b?F,\n              chars=[\"a\",\"2\",\"b\"//,\"b\",\"c\",\"c\",\"c\"],write=3\n              digits=\"2\",\n              chars=[\"a\",\"2\",\"b\",\"2\"//,\"c\",\"c\",\"c\"],write=4\n4     4      A.4<7?T->count=0,current=c\n4     4      B.4<7and c==c?T,count=1,read=5\n5     4      B.5<7and c==c?T,count=2,read=6\n7     4      B.7<7and c==c?T,count=3,read=7\n6     4      B.7<7and -?F,\n              chars=[\"a\",\"2\",\"b\",\"2\",\"c\"//,\"c\",\"c\"], write=5\n              digits=\"3\",chars=[\"a\",\"2\",\"b\",\"2\",\"c\",\"5\"//,\"c\"],write=6\n7     6      stop, return 6\n             ",
      "autoResize": true,
      "lineHeight": 1.25
    },
