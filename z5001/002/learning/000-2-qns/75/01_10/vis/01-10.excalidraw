    {
      "id": "QufhYHEpqYM0dfRlpua2S",
      "type": "text",
      "x": 270.2450587224215,
      "y": 3852.6170275680483,
      "width": 393.40765380859375,
      "height": 259.20000000000005,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
