      "link": null,
      "locked": false,
      "text": "`slow` represent: position to place next non-zero\n`fast` represent: current scanning position\nWhen nums[fast] != 0\n        -> swap: nums[slow] and nums[fast]\n           then: slow++",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "`slow` represent: position to place next non-zero\n`fast` represent: current scanning position\nWhen nums[fast] != 0\n        -> swap: nums[slow] and nums[fast]\n           then: slow++",
      "autoResize": true,
      "lineHeight": 1.25
    },
