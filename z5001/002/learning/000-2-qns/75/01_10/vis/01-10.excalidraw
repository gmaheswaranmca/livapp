      "isDeleted": false,
      "boundElements": [],
      "updated": 1781679768023,
      "link": null,
      "locked": false,
      "text": "candies = [2,3,5,1,3]\nextraCandies = 3\n...\nmax([2,3,5,1,3]) = 5\nfor each candyCount + extra(3) \n-> [2+3,3+3,5+3,1+3,3+3]\n-> [5, 6, 8, 4, 6]\n-> [t, t,  t, f, t]",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "candies = [2,3,5,1,3]\nextraCandies = 3\n...\nmax([2,3,5,1,3]) = 5\nfor each candyCount + extra(3) \n-> [2+3,3+3,5+3,1+3,3+3]\n-> [5, 6, 8, 4, 6]\n-> [t, t,  t, f, t]",
      "autoResize": true,
      "lineHeight": 1.25
    },
