      "versionNonce": 1958147625,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781678549473,
      "link": null,
      "locked": false,
      "text": "function increasingTriplet(nums):\n    first = +infinity\n    second = +infinity\n    for num in nums:\n        if num <= first:\n            first = num\n        else if num <= second:\n            second = num\n        else:\n            return true\n    return false",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function increasingTriplet(nums):\n    first = +infinity\n    second = +infinity\n    for num in nums:\n        if num <= first:\n            first = num\n        else if num <= second:\n            second = num\n        else:\n            return true\n    return false",
      "autoResize": true,
      "lineHeight": 1.25
    },
