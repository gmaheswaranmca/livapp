      "isDeleted": false,
      "boundElements": [],
      "updated": 1781680496888,
      "link": null,
      "locked": false,
      "text": "function moveZeroes(nums):\n    slow = 0\n    for fast from 0 to n-1:\n        if nums[fast] != 0:\n            swap(nums[slow], nums[fast])\n            slow++",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function moveZeroes(nums):\n    slow = 0\n    for fast from 0 to n-1:\n        if nums[fast] != 0:\n            swap(nums[slow], nums[fast])\n            slow++",
      "autoResize": true,
      "lineHeight": 1.25
    }
