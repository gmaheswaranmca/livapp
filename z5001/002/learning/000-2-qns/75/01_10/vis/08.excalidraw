      "text": "-inf[2,1,5,0,4,6]  first < second < num?\n                   A.num<=first->fir=num OR \n                   B.num<=second->sec=num OR  \nfir   sec   num    C.else -> return TRUE\n+inf  +inf  2      A.2<=+inf?T,first=2 \n2     +inf  1      A.1<=2?T,first=1 \n1     +inf  5      A.5<=1?F, B.5<=+inf?T,sec=5 \n1     5     0      A.0<=1?T,first=0\n0     5     4      A.4<=0?F, B.4<=5?T,sec=4 \n0     4     6      A.6<=0?F |B.6<=4?F| ret true",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-inf[2,1,5,0,4,6]  first < second < num?\n                   A.num<=first->fir=num OR \n                   B.num<=second->sec=num OR  \nfir   sec   num    C.else -> return TRUE\n+inf  +inf  2      A.2<=+inf?T,first=2 \n2     +inf  1      A.1<=2?T,first=1 \n1     +inf  5      A.5<=1?F, B.5<=+inf?T,sec=5 \n1     5     0      A.0<=1?T,first=0\n0     5     4      A.4<=0?F, B.4<=5?T,sec=4 \n0     4     6      A.6<=0?F |B.6<=4?F| ret true",
      "autoResize": true,
      "lineHeight": 1.25
    },
