      "updated": 1781680334725,
      "link": null,
      "locked": false,
      "text": "Input: s = \"the sky is blue\"\nOutput: \"blue is sky the\"\n...\nInput: s = \"  hello world  \"\nOutput: \"world hello\"\nExplanation: Your reversed string \nshould not contain leading or \ntrailing spaces.\n...\nInput: s = \"a good   example\"\nOutput: \"example good a\"\nExplanation: You need to reduce \nmultiple spaces between two words \nto a single space in the reversed string.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Input: s = \"the sky is blue\"\nOutput: \"blue is sky the\"\n...\nInput: s = \"  hello world  \"\nOutput: \"world hello\"\nExplanation: Your reversed string \nshould not contain leading or \ntrailing spaces.\n...\nInput: s = \"a good   example\"\nOutput: \"example good a\"\nExplanation: You need to reduce \nmultiple spaces between two words \nto a single space in the reversed string.",
      "autoResize": true,
      "lineHeight": 1.35
    },
