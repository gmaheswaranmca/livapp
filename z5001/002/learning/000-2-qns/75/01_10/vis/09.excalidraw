      "seed": 446574047,
      "version": 327,
      "versionNonce": 38944671,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1781680464378,
      "link": null,
      "locked": false,
      "text": "function compress(chars):\n    read = 0\n    write = 0\n    while read < n:\n        current = chars[read]\n        count = 0\n        while read < n and chars[read] == current:\n            read++\n            count++\n        chars[write] = current\n        write++\n        if count > 1:\n            digits = toString(count)\n            for d in digits:\n                chars[write] = d\n                write++\n    return write",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function compress(chars):\n    read = 0\n    write = 0\n    while read < n:\n        current = chars[read]\n        count = 0\n        while read < n and chars[read] == current:\n            read++\n            count++\n        chars[write] = current\n        write++\n        if count > 1:\n            digits = toString(count)\n            for d in digits:\n                chars[write] = d\n                write++\n    return write",
      "autoResize": true,
      "lineHeight": 1.25
    },
