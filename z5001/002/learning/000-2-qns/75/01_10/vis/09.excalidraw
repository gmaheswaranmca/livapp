    {
      "id": "rV03sGUhzTOvuszzUODmf",
      "type": "text",
      "x": 1367.124354935677,
      "y": 4474.83783632501,
      "width": 439.9993896484375,
      "height": 340,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#1e1e1e",
