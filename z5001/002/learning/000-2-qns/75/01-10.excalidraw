    },
    {
      "id": "Jz1Ugz3_XSrJJpJPOoHpE",
      "type": "text",
      "x": 273.2450587224215,
      "y": 2849.2170275680483,
      "width": 389.959716796875,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
