      "text": "s = the sky is blue\nr = s.trim().split(\" \")\nans = \"\"\ni = len(r) - 1\nwhile i >= 0\n    if trim(r[i]) != \"\"\n        if ans != \"\":\n            ans = ans + \" \"\n        ans = ans + r[i]\n    i--\nreturn ans",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "s = the sky is blue\nr = s.trim().split(\" \")\nans = \"\"\ni = len(r) - 1\nwhile i >= 0\n    if trim(r[i]) != \"\"\n        if ans != \"\":\n            ans = ans + \" \"\n        ans = ans + r[i]\n    i--\nreturn ans",
      "autoResize": true,
      "lineHeight": 1.25
    },
