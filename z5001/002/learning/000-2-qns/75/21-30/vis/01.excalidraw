      "text": "::Dry Run::\ncountStack:[]\nstringStack:[]\n\ncurrentString=\"\"\ncurrentNumber=0\n\ns=\"2[abc]3[cd]ef\"\nch action\n2  digit?T->currentNumber=0*10+(ch-'0')=2\n[  [?T->countStack:[2], stringStack=[\"\"],\n   currentString=\"\", currentNumber=0\na  else?T->currentString=\"a\"\nb  else?T->currentString=\"ab\"\nc  else?T->currentString=\"abc\"\n]  ]?T->repeatCount=popCntStk()=2\n   countStack:[],prevStr=popStrStk()=abc,\n   stringStack=[],\n   currentString=\"\"+[\"abc\"*2]=\"abcabc\"\n3  digit?T->currentNumber=0*10+(ch-'0')=3\n[  [?T->countStack:[3], stringStack=[\"abcabc\"],\n   currentString=\"\", currentNumber=0\nc  else?T->currentString=\"c\"\nd  else?T->currentString=\"cd\"\n]  ]?T->repeatCount=popCntStk()=3\n   countStack:[],prevStr=popStrStk()=abcabc,\n   stringStack=[],\n   currentString=\"abcabc\"+[\"cd\"*3]=\"abcabccdcdcd\"\ne  else?T->currentString=\"abcabccdcdcde\"\nf  else?T->currentString=\"abcabccdcdcdef\"\nreturn currentString=\"abcabccdcdcdef\"\nEnd",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
